{
  "schemaVersion": 1,
  "policyVersion": "2026-08-28.2",
  "publicBuild": {
    "committedOnly": true,
    "requireCleanMarkdown": true,
    "plainWikiMode": "ignore",
    "includedAuthorities": [
      "canonical",
      "reference"
    ],
    "warningBytes": 2000000,
    "maxBytes": 12000000
  },
  "globalExclusions": [
    ".kx_deploy_backups/**",
    "_pipeline-plan-diag_*/**",
    "_diagnostics/**",
    "tmp/**",
    ".tmp/**"
  ],
  "repositories": {
    "Konnaxion": {
      "rules": [
        {
          "pattern": ".kx_deploy_backups/**",
          "authority": "historical",
          "include": false
        }
      ]
    },
    "kOA-Linux": {
      "selectionMode": "curated",
      "includeWiki": false,
      "includePatterns": [
        "docs/AI_CONTEXT.md",
        "docs/contracts/ai-navigation.contract.json",
        "docs/contracts/*.contract.json",
        "docs/contracts/components/*.component.json",
        "docs/contracts/subsystems/*.subsystem.json",
        "docs/contracts/profiles/*.profile.json",
        "docs/contracts/integrations/*.integration.json",
        "docs/contracts/toolchains/*.toolchain.json",
        "docs/generated/ai-context/*.json",
        "docs/generated/authority-manifest.json",
        "docs/generated/document-index.json",
        "docs/generated/component-catalog.json",
        "docs/generated/subsystem-catalog.json",
        "docs/generated/profile-catalog.json",
        "docs/generated/requirements-index.json",
        "docs/generated/assertion-index.json",
        "docs/generated/traceability.json"
      ],
      "requiredPatterns": [
        "docs/AI_CONTEXT.md",
        "docs/contracts/ai-navigation.contract.json",
        "docs/generated/ai-context/*.json",
        "docs/generated/document-index.json",
        "docs/generated/component-catalog.json",
        "docs/generated/subsystem-catalog.json",
        "docs/generated/profile-catalog.json",
        "docs/generated/requirements-index.json",
        "docs/generated/assertion-index.json",
        "docs/generated/traceability.json",
        "docs/generated/ai-context/koa-navigation.json",
        "docs/generated/authority-manifest.json",
        "docs/contracts/*.contract.json",
        "docs/contracts/components/*.component.json",
        "docs/contracts/subsystems/*.subsystem.json",
        "docs/contracts/profiles/*.profile.json",
        "docs/contracts/integrations/*.integration.json",
        "docs/contracts/toolchains/*.toolchain.json"
      ],
      "readFirst": [
        "docs/AI_CONTEXT.md",
        "docs/contracts/ai-navigation.contract.json",
        "docs/generated/ai-context/koa-navigation.json",
        "docs/generated/ai-context/*.json",
        "docs/generated/authority-manifest.json",
        "docs/generated/document-index.json",
        "docs/generated/component-catalog.json",
        "docs/generated/subsystem-catalog.json",
        "docs/generated/profile-catalog.json",
        "docs/generated/requirements-index.json",
        "docs/generated/assertion-index.json",
        "docs/generated/traceability.json"
      ],
      "rules": [
        {
          "pattern": "docs/AI_CONTEXT.md",
          "authority": "reference",
          "include": true
        },
        {
          "pattern": "docs/generated/**",
          "authority": "reference",
          "include": true
        }
      ]
    },
    "Kristal_Farms": {
      "rules": [
        {
          "pattern": "archive/**",
          "authority": "historical",
          "include": false
        }
      ]
    },
    "Orgo": {
      "rules": [
        {
          "pattern": "Docs/Technical-Reference/Architecture upgrade(to do)/**",
          "authority": "proposal",
          "include": false
        }
      ]
    },
    "UCKK-Moodle": {
      "rules": [
        {
          "pattern": "string_inventory/**",
          "authority": "reference",
          "include": false
        }
      ]
    }
  },
  "legacyExemptFiles": [
    "grammatical-framework-context-pack--rgl-router-and-reference--v1.0.txt",
    "senior-architect-context-pack--systems-patterns-and-resilience--v1.0.txt"
  ]
}
