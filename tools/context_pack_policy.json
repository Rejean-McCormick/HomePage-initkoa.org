{
  "schemaVersion": 1,
  "policyVersion": "2026-09-01.10",
  "publicBuild": {
    "committedOnly": true,
    "requireCleanMarkdown": true,
    "plainWikiMode": "ignore",
    "includedAuthorities": [
      "canonical",
      "reference"
    ],
    "warningBytes": 2000000,
    "maxBytes": 12000000
  },
  "globalExclusions": [
    ".kx_deploy_backups/**",
    "_pipeline-plan-diag_*/**",
    "_diagnostics/**",
    "tmp/**",
    ".tmp/**"
  ],
  "repositories": {
    "Konnaxion": {
      "rules": [
        {
          "pattern": ".kx_deploy_backups/**",
          "authority": "historical",
          "include": false
        }
      ]
    },
    "kOA-Linux": {
