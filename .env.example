# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this in client components or browser code.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Used by scripts that generate public artifacts such as:
# public/reading/ai-index.json
#
# Example:
# NEXT_PUBLIC_SITE_URL=https://initkoa.com
NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# Reading import
# -----------------------------------------------------------------------------

# Directory scanned by scripts/import-reading-md-to-db.mjs
READING_IMPORT_DIR=content/reading-inbox

# Optional output path for scripts/generate-reading-ai-index.mjs
READING_AI_INDEX_PATH=public/reading/ai-index.json


# -----------------------------------------------------------------------------
# Optional / future imports
# -----------------------------------------------------------------------------

# Only needed if/when Medium import is enabled.
MEDIUM_RSS_URL=
MEDIUM_SOURCE_DIR=content/medium/source

# Only needed if/when PDF import is enabled.
PDF_IMPORT_DIR=content/pdf-inbox


# -----------------------------------------------------------------------------
# Optional / future AI embeddings
# -----------------------------------------------------------------------------

# Not required for the current Markdown index/display build.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small